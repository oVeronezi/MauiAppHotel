<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             Title="HospedagemContratada"
             BackgroundColor="{StaticResource Gray100}">

    <VerticalStackLayout>

        <Label Text="{Binding QuartoSelecionado.Descricao}"
            TextColor="{StaticResource Primary}"
            FontFamily="MozillaText"
            FontSize="50"
            HorizontalTextAlignment="Center"/>

        <Border StrokeShape="RoundRectangle 10" BackgroundColor="{StaticResource Gray950}" 
                Padding="10" Margin="5">
            <Grid RowDefinitions="Auto" ColumnDefinitions="*, *, *, *">

                <!-- Adultos -->
                <Label Grid.Row="0" Grid.Column="0" Text="Adultos:"/>
                <Label Grid.Row="0" Grid.Column="1" Text="{Binding QntAdultos}"/>

                <!-- Crianças -->
                <Label Grid.Row="0" Grid.Column="2" Text="Crianças:"/>
                <Label Grid.Row="0" Grid.Column="3" Text="{Binding QntCriancas}"/>
            </Grid>
        </Border>

        <Border StrokeShape="RoundRectangle 10" Padding="10" Margin="5" 
                BackgroundColor="{StaticResource Gray950}">
            <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, *, *" 
                  BackgroundColor="{StaticResource Gray950}">

                <!-- Informações -->
                <Label Grid.Row="0" Grid.Column="0" Text="Data do Check-in:"/>
                <Label Grid.Row="1" Grid.Column="0" Text="{Binding DataCheckin, 
                    StringFormat='{}{0:dd/MM/yyyy}'}"/>

                <Label Grid.Row="0" Grid.Column="1" Text="Data do Check-out:"/>
                <Label Grid.Row="1" Grid.Column="1" Text="{Binding DataCheckout, StringFormat='{}{0:dd/MM/yyyy}'}"/>

                <Label Grid.Row="0" Grid.Column="2" Text="Estadia:"/>
                <Label Grid.Row="1" Grid.Column="2" Text="{Binding Estadia}"/>

            </Grid>
        </Border>

        <Border StrokeShape="RoundRectangle 10"
                BackgroundColor="{StaticResource Gray950}"
                Padding="10"
                Margin="5">
            <VerticalStackLayout>
                <Label Text="Valor Total: "/>
                <Label Text="{Binding ValorTotal, StringFormat='{}{0:c}'}"
                       TextColor="{StaticResource PrimaryDark}"/>
            </VerticalStackLayout>
        </Border>

    </VerticalStackLayout>
</ContentPage>